{
  "compilerOptions": {
    "target": "ESNext", // Modern JavaScript syntax
    "module": "NodeNext", // ESM module compatibility
    "moduleResolution": "NodeNext", // Required for resolveJsonModule
    "outDir": "./dist", // Output directory for compiled files
    "rootDir": "./src", // Root directory of source files
    "strict": true, // Enables all strict type-checking options
    "esModuleInterop": true, // Ensures compatibility with CommonJS modules
    "resolveJsonModule": true, // Allows importing JSON files
    "forceConsistentCasingInFileNames": true, // Enforces consistent casing
    "skipLibCheck": true, // Skips type checking of declaration files
    "declaration": true, // Generates .d.ts files for TypeScript types
    "sourceMap": true, // Generates source maps for debugging
    "allowSyntheticDefaultImports": true, // Allows default imports for CommonJS
    "noEmitOnError": true, // Prevents output if there are errors
    "lib": ["ESNext", "DOM"], // Includes standard ESNext and DOM libraries
    "allowJs": false, // Disallows JavaScript files
    "strictNullChecks": true, // Ensures null/undefined are handled explicitly
    "types": ["node"] // Includes Node.js types
  },
  "include": ["src/**/*", "ecosystem.config.js"], // Includes all TypeScript files in the src folder
  "exclude": ["node_modules", "dist"] // Excludes unnecessary files/folders
}
