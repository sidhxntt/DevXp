generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscribing_User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String?
  subscribedAt DateTime?
}

model User {
  id            Int      @id @default(autoincrement())
  Clerk_User_Id String   @unique
  email         String   @unique
  name          String?
  phone_number  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relation to the Favorite model to track a user's favorites
  favorites     Favorite[] // A user can have many favorites
}

model Blogs {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  contentType String
  readingTime String   // Can store as a string or as an integer (e.g., minutes)
  createdAt   DateTime @default(now())

  // Relation to the Favorite model to track which users have favorited this blog
  favorites   Favorite[] // A blog can have many users who favorited it
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  blogId    Int
  favoredAt DateTime @default(now())  // Track when it was marked as a favorite

  User      User     @relation(fields: [userId], references: [id])
  Blog      Blogs    @relation(fields: [blogId], references: [id])

  // Enforce uniqueness: A user cannot favorite the same blog more than once
  @@unique([userId, blogId]) 
}
